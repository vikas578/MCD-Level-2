<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="munit-test-suite.xml" />
	<munit:test name="munit-test-success-path" doc:id="0e158c70-21f4-4da7-bc99-abbbcba410a4" tags="UNIT-TEST" description="Testing CH2 flow for adding user ">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock when" doc:id="8ffbfd01-e54d-4ef4-ad7e-3562e123769f" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="f7c03dbc-97d4-4b35-b44a-dd6e9eea3b5c" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:variables >
						<munit-tools:variable key="addUserResponse" value="#[output application/json --- read(MunitTools::getResourceAsString('post-user-response.json'), 'application/json')]" mediaType="application/json" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event doc:name="Set Payload and QueryParam" doc:id="4838633a-3f04-42eb-84eb-58d2611670cc" >
				<munit:payload value="#[output application/json --- read(MunitTools::getResourceAsString('post-user-request.json'), 'application/json')]" />
				<munit:attributes value="#[{queryParams : {status:200}}]" />
			</munit:set-event>
			<flow-ref doc:name="ch2-demo-apiFlow" doc:id="c37f4d6a-1b4d-46a5-89f3-78f63b9f53eb" name="ch2-demo-apiFlow"/>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that Payload is NOT NULL" doc:id="ece0a5de-c41a-44a5-989d-9476578722cf" expression="#[payload]" is="#[MunitTools::notNullValue()]" message="Payload is Null"/>
			<munit-tools:assert-that doc:name="Assert that Payload is adding User" doc:id="5acb4317-32d3-459d-a055-19ac99f086eb" expression="#[payload.addUser.id]" is="#[MunitTools::equalTo(209)]" message="User is not added properly"/>
		</munit:validation>
	</munit:test>


</mule>
